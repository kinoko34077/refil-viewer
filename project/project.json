{
  "schema_version": 1,
  "project": {
    "name": "refil-viewer",
    "type": "vite-web-app",
    "description": "Vue/Vite browser viewer for refil content with Project-owned rendering and export behavior."
  },
  "profile": "web-app",
  "profiles": [
    "web-app"
  ],
  "runtime": {
    "modules": []
  },
  "surfaces": {
    "cli": false,
    "gui_windows": false,
    "web": true,
    "api": false,
    "mcp": false,
    "agent": false,
    "library": false
  },
  "commands": {
    "setup": {
      "exec": "npm",
      "args": ["ci"],
      "cwd": ".",
      "forward_args": false
    },
    "dev": {
      "exec": "npm",
      "args": ["run", "dev"],
      "cwd": ".",
      "forward_args": false
    },
    "test": {
      "exec": "npm",
      "args": ["test"],
      "cwd": ".",
      "forward_args": false
    },
    "build": {
      "exec": "npm",
      "args": ["run", "build"],
      "cwd": ".",
      "forward_args": false
    },
    "verify": {
      "exec": "npm",
      "args": ["run", "verify"],
      "cwd": ".",
      "forward_args": false
    },
    "smoke": "",
    "deploy": ""
  },
  "paths": {
    "docs": "docs/",
    "source": "../src/",
    "actions": "contracts/actions.json",
    "surfaces": "contracts/surfaces.json",
    "defaults": "defaults.json"
  },
  "notes": [
    "This adoption adds the KiNoTch Base and Project Overlay without moving the existing Vue/Vite files.",
    "Viewer rendering, data formats, export behavior, and release policy remain Project-owned."
  ]
}
